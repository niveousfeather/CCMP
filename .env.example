DATABASE_URL="file:./dev.db"
# 本地 HTTP 保持 false；部署到 HTTPS 时设为 true。
SESSION_COOKIE_SECURE=false
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin123456"
DEFAULT_USER_PASSWORD="ChangeMe123!"
DEFAULT_USER_QUOTA=100
XHEAI_API_KEY=
XHEAI_BALANCE_TOKEN=
MOONSHOT_API_KEY=
CLAUDECODER_API_KEY=
AGENT_TASK_API_KEY=
XHEAI_BASE_URL=https://api.xheai.cc
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
CLAUDECODER_BASE_URL=https://china.claudecoder.me/v1
# Agent tool layer powered by Kimi. Falls back to MOONSHOT_API_KEY/MOONSHOT_BASE_URL when empty.
AGENT_KIMI_API_KEY=
AGENT_KIMI_BASE_URL=https://api.moonshot.cn/v1
AGENT_KIMI_FILE_MODEL=kimi-k2.5
AGENT_KIMI_IMAGE_MODEL=kimi-k2.5
AGENT_KIMI_VIDEO_MODEL=kimi-k2.5
AGENT_KIMI_SUMMARY_MODEL=kimi-k2.5
AGENT_KIMI_WEB_SUMMARY_MODEL=kimi-k2.5
# Agent response routing. Fast chat uses XHEAI GPT-5.4; background task planning uses Subrouter GPT-5.4 with Kimi fallback.
AGENT_CHAT_MODEL=gpt-5.4
AGENT_TASK_PROVIDER=subrouter
AGENT_TASK_BASE_URL=https://subrouter.ai/v1
AGENT_TASK_MODEL=gpt-5.4
AGENT_TASK_FALLBACK_MODEL=kimi-k2.5
AGENT_FAST_CHAT_TIMEOUT_MS=15000
AGENT_TASK_TIMEOUT_MS=240000
AGENT_TASK_PRIMARY_TIMEOUT_MS=15000
AGENT_TASK_FALLBACK_TIMEOUT_MS=10000
AGENT_WORD_TASK_PRIMARY_TIMEOUT_MS=420000
AGENT_WORD_TASK_FALLBACK_TIMEOUT_MS=240000
AGENT_WORD_TASK_REPAIR_TIMEOUT_MS=240000
AGENT_WORD_ASYNC_TASK_TIMEOUT_MS=600000

# Image generation model. These keys are only for GPT-image2 image generation and must not be reused by Agent/Word tasks.
IMAGE2_PROVIDER=subrouter
IMAGE2_BASE_URL=https://subrouter.ai/v1
IMAGE2_MODEL=gpt-image-2
IMAGE2_API_KEY_1=
IMAGE2_API_KEY_2=
IMAGE2_API_KEY_3=
IMAGE2_MAX_CONCURRENT_PER_KEY=2
IMAGE2_REQUEST_TIMEOUT_MS=300000
IMAGE2_RETRY_ENABLED=true
ALI_OSS_REGION=
ALI_OSS_BUCKET=
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_ENDPOINT=
# Agent web search. Self-hosted SearXNG is primary; Baidu Qianfan is fallback.
AGENT_WEB_PRIMARY=self_hosted
AGENT_WEB_SELF_HOSTED_ENABLED=true
AGENT_SEARXNG_ENDPOINT=http://127.0.0.1:8080/search
AGENT_WEB_FETCH_MAX_RESULTS=12
AGENT_WEB_FETCH_MAX_PAGES=5
AGENT_WEB_FETCH_TIMEOUT_MS=8000
AGENT_WEB_PAGE_MAX_BYTES=2000000
AGENT_WEB_PAGE_SNIPPET_CHARS=1800
AGENT_WEB_RESPECT_ROBOTS=true
AGENT_WEB_USER_AGENT=NexusAI-WebContext/1.0

# Baidu Qianfan AI Search fallback. API key stays server-side only.
AGENT_WEB_SEARCH_API_KEY=
AGENT_WEB_SEARCH_MODE=web_search
AGENT_WEB_SEARCH_ENDPOINT=https://qianfan.baidubce.com/v2/ai_search/web_search
AGENT_WEB_SEARCH_MODEL=ernie-4.5-turbo-32k
AGENT_WEB_SEARCH_SOURCE=baidu_search_v2
AGENT_WEB_SEARCH_TOP_K=5

# Volcengine Visual API for JiMeng image 2.1 and JiMeng video generation. Credentials stay server-side only.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_REGION=cn-north-1
VOLCENGINE_VISUAL_ENDPOINT=https://visual.volcengineapi.com

# Tripo 3D API. Credentials stay server-side only; 3D workspace is currently a staged integration.
# Fill TRIPO_API_KEY with your Tripo platform API key before enabling real 3D generation.
TRIPO_API_KEY=
TRIPO_BASE_URL=https://api.tripo3d.com/v2/openapi
# Default: v2.5 + standard texture. Keep the frontend name as "Nexus 3D Preview".
TRIPO_MODEL_VERSION=v2.5-20250123
TRIPO_TIMEOUT_MS=300000

# Generation queue controls for image / video / 3D tasks.
# Keep video and 3D conservative because provider-side tasks are longer and may hit concurrency limits.
GENERATION_QUEUE_CONCURRENCY=1
GENERATION_IMAGE_CONCURRENCY=2
GENERATION_VIDEO_CONCURRENCY=1
GENERATION_MODEL3D_CONCURRENCY=1
GENERATION_QUEUE_MAX_RETRIES=3
GENERATION_QUEUE_RETRY_BASE_MS=12000
GENERATION_MODEL3D_RETRY_BASE_MS=20000

# Optional server cron token for GET /api/model3d/health.
# Example Nginx/server cron can call it daily at 08:00 without creating paid 3D tasks.
MODEL3D_HEALTH_CRON_TOKEN=
