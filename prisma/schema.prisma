generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  username                String                  @unique
  password_hash           String
  role                    Role                    @default(TEACHER)
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt
  quota                   UserQuota?
  imageGenerations        ImageGeneration[]
  videoGenerations        VideoGeneration[]
  model3DGenerations      Model3DGeneration[]
  chatConversations       ChatConversation[]
  chatAttachments         ChatAttachment[]
  favorites               Favorite[]
  agentPreference         AgentPreference?
  usageRecords            UsageRecord[]
  knowledgeGraphHistories KnowledgeGraphHistory[]
}

model VideoGeneration {
  id                   String   @id @default(cuid())
  userId               String
  prompt               String
  imageUrl             String?
  imageObjectKey       String?
  model                String
  resolution           String
  duration             String?
  ratio                String?
  taskId               String?
  status               String
  resultVideoUrl       String?
  resultVideoObjectKey String?
  coverImageUrl        String?
  coverImageObjectKey  String?
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([taskId])
}

model Model3DGeneration {
  id                    String   @id @default(cuid())
  userId                String
  taskId                String   @unique
  provider              String   @default("tripo")
  providerTaskId        String?
  feature               String
  title                 String
  prompt                String
  mode                  String
  model                 String
  status                String
  rawStatus             String?
  quality               String?
  generationProfile     String?
  textureEnabled        Boolean  @default(true)
  textureQuality        String?
  pbrEnabled            Boolean  @default(false)
  generatePartsEnabled  Boolean  @default(false)
  inputImageUrl         String?
  inputImagesJson       String?
  modelUrl              String?
  modelObjectKey        String?
  previewImageUrl       String?
  previewImageObjectKey String?
  exportUrl             String?
  exportObjectKey       String?
  errorMessage          String?
  providerMeta          String?
  operationsJson        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([providerTaskId])
}

model UserQuota {
  id         String   @id @default(cuid())
  userId     String   @unique
  totalQuota Int      @default(100)
  usedQuota  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoleQuota {
  id                String   @id @default(cuid())
  role              Role     @unique
  imageDailyLimit   Int      @default(10)
  videoDailyLimit   Int      @default(2)
  model3DDailyLimit Int      @default(2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UsageRecord {
  id            String   @id @default(cuid())
  userId        String
  featureType   String
  relatedTaskId String?
  status        String?
  note          String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureType, createdAt])
  @@index([relatedTaskId])
}

model ErrorLog {
  id        String   @id @default(cuid())
  userId    String?
  route     String
  method    String
  status    Int?
  code      String?
  provider  String?
  traceId   String?
  message   String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([route, createdAt])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

model ImageGeneration {
  id            String       @id @default(cuid())
  userId        String
  prompt        String
  finalPrompt   String?
  model         String
  style         String?
  aspectRatio   String
  resolution    String
  mode          String       @default("text-to-image")
  status        String
  failureReason String?
  count         Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets        ImageAsset[]

  @@index([userId, createdAt])
}

model ImageAsset {
  id           String          @id @default(cuid())
  generationId String
  index        Int
  sourceType   String
  url          String?
  objectKey    String?
  mimeType     String?
  width        Int?
  height       Int?
  sizeBytes    Int?
  createdAt    DateTime        @default(now())
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId, index])
}

model ChatConversation {
  id          String           @id @default(cuid())
  userId      String
  title       String
  model       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  attachments ChatAttachment[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String
  model          String?
  error          String?
  metadata       String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    ChatAttachment[]

  @@index([conversationId, createdAt])
}

model ChatAttachment {
  id             String           @id @default(cuid())
  messageId      String?
  conversationId String
  userId         String
  fileName       String
  mimeType       String?
  sizeBytes      Int
  objectKey      String?
  url            String?
  providerFileId String?
  extractedText  String?
  createdAt      DateTime         @default(now())
  message        ChatMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType, createdAt])
}

model AgentPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  fileName     String?
  documentType String?
  styleHint    String?
  lengthHint   String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeGraphHistory {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  title     String
  summary   String?
  graphJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}
